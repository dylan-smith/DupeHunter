<UserControl x:Class="DupeHunter.Gui.Views.BackupEntriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:DupeHunter.Gui.Views">
    <UserControl.Resources>
        <views:BytesToHumanConverter x:Key="Bytes" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="240" MinHeight="100" />
        </Grid.RowDefinitions>

        <DataGrid x:Name="EntriesGrid"
                  Grid.Row="0"
                  ItemsSource="{Binding Entries, RelativeSource={RelativeSource AncestorType=views:BackupEntriesView}}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  EnableRowVirtualization="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.ScrollUnit="Item">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsGone}" Value="True">
                            <Setter Property="Foreground" Value="LightGray" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Size" Binding="{Binding SizeBytes, Converter={StaticResource Bytes}}" Width="90" />
                <DataGridTextColumn Header="Files" Binding="{Binding FileCountText}" Width="70" />
                <DataGridTextColumn Header="Match" Binding="{Binding MatchKindText}" Width="70" />
                <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="200" />
            </DataGrid.Columns>
        </DataGrid>

        <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="#DDD" />

        <Grid Grid.Row="2" DataContext="{Binding SelectedItem, ElementName=EntriesGrid}">
            <TextBlock Text="Select an entry above to review it — everything listed here already exists outside the backup."
                       Margin="10" Foreground="Gray">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <DockPanel>
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>

                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,8,10,4">
                    <TextBlock FontWeight="Bold" Text="{Binding Name}" />
                    <TextBlock Margin="12,0,0,0" Text="Its content already exists outside the backup — delete it from the backup, or keep it and dismiss the suggestion." />
                </StackPanel>

                <DockPanel DockPanel.Dock="Top" Margin="10,2,10,4">
                    <Button DockPanel.Dock="Left" Content="Delete" Width="60" Margin="0,0,6,0"
                            Command="{Binding DeleteCommand}" />
                    <Button DockPanel.Dock="Left" Content="Keep in backup" Width="110" Margin="0,0,6,0"
                            Command="{Binding KeepCommand}" />
                    <Button DockPanel.Dock="Left" Content="Explorer" Width="70" Margin="0,0,10,0"
                            Command="{Binding OpenInExplorerCommand}" />
                    <TextBlock DockPanel.Dock="Right" Margin="10,0,0,0" VerticalAlignment="Center"
                               Text="{Binding StatusText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="Gray" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                        <Setter Property="Foreground" Value="DarkRed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBox Text="{Binding FullPath, Mode=OneWay}" IsReadOnly="True"
                             BorderThickness="0" Background="Transparent"
                             VerticalAlignment="Center" TextWrapping="NoWrap">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGone}" Value="True">
                                        <Setter Property="Foreground" Value="LightGray" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </DockPanel>

                <TextBlock DockPanel.Dock="Top" Margin="10,6,10,2" Foreground="Gray"
                           Text="Content also exists at (a sample, not exhaustive):" />

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding ExternalLocations}" Margin="10,0,10,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <Button DockPanel.Dock="Left" Content="Explorer" Width="70" Margin="0,0,10,0"
                                            Command="{Binding DataContext.RevealLocationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                    <TextBox Text="{Binding Mode=OneWay}" IsReadOnly="True"
                                             BorderThickness="0" Background="Transparent"
                                             VerticalAlignment="Center" TextWrapping="NoWrap" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
