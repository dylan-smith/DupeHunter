<Window x:Class="DupeHunter.Gui.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DupeHunter.Gui.Views"
        xmlns:vm="clr-namespace:DupeHunter.Gui.ViewModels"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="DupeHunter — duplicate review"
        Width="1200" Height="800"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <views:BytesToHumanConverter x:Key="Bytes" />
    </Window.Resources>
    <DockPanel>
        <!-- Toolbar -->
        <Grid DockPanel.Dock="Top" Margin="10,8" IsEnabled="{Binding IsNotBusy}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Report:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Grid.Column="1" Text="{Binding ReportPath, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center"
                     ToolTip="Path to a .yml report written by the dupehunter CLI (duplicates) or dupehunter-backup CLI (backup redundancy). Reviewing entries here updates this file; the scan database is never touched." />
            <Button Grid.Column="2" Content="Open…" Margin="6,0,0,0" Padding="10,2"
                    Command="{Binding OpenReportCommand}" />
            <Button Grid.Column="3" Content="Refresh" Margin="6,0,16,0" Padding="10,2"
                    Command="{Binding RefreshCommand}" />
            <TextBlock Grid.Column="4" Text="Min size (MB):" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Grid.Column="5" Text="{Binding MinWastedMb}" Width="60" VerticalContentAlignment="Center" Margin="0,0,16,0"
                     ToolTip="Hide duplicate sets wasting less than this (or backup entries smaller than this). A view filter only — the report file keeps every entry. Takes effect on Refresh." />
            <TextBox Grid.Column="6" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Width="200" VerticalContentAlignment="Center"
                     ToolTip="Filter groups by name" />
        </Grid>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <ProgressBar Width="90" Height="12" Margin="0,0,8,0" IsIndeterminate="True"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding StatusText}" />
                </StackPanel>
            </StatusBarItem>
            <Separator />
            <StatusBarItem Content="{Binding ScanSummary}" />
            <Separator />
            <StatusBarItem Content="{Binding TotalWastedText}" />
        </StatusBar>

        <!-- Review lists: one tab set per report kind, switched by what the probe detected. -->
        <Grid Margin="10,0,10,6">
            <TabControl Visibility="{Binding IsDuplicateReport, Converter={StaticResource BoolToVis}}">
                <TabItem Header="Duplicate folders">
                    <views:GroupsView Groups="{Binding FolderGroupsView}" />
                </TabItem>
                <TabItem Header="Duplicate files">
                    <views:GroupsView Groups="{Binding FileGroupsView}" />
                </TabItem>
            </TabControl>

            <TabControl Visibility="{Binding IsBackupReport, Converter={StaticResource BoolToVis}}">
                <TabItem Header="Deletable folders">
                    <views:BackupEntriesView Entries="{Binding BackupFolderEntriesView}" />
                </TabItem>
                <TabItem Header="Deletable files">
                    <views:BackupEntriesView Entries="{Binding BackupFileEntriesView}" />
                </TabItem>
                <TabItem Header="Unverifiable (keep)">
                    <DataGrid ItemsSource="{Binding UnverifiableFiles}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              EnableRowVirtualization="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Item">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*" />
                            <DataGridTextColumn Header="Size" Binding="{Binding SizeBytes, Converter={StaticResource Bytes}}" SortMemberPath="SizeBytes" Width="90" />
                            <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="220" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="Unmatched (keep)">
                    <DataGrid ItemsSource="{Binding UnmatchedFiles}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              EnableRowVirtualization="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Item">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*" />
                            <DataGridTextColumn Header="Size" Binding="{Binding SizeBytes, Converter={StaticResource Bytes}}" SortMemberPath="SizeBytes" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
