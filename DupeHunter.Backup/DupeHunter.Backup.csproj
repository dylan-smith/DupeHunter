<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>dupehunter-backup</AssemblyName>
    <RootNamespace>DupeHunter.Backup</RootNamespace>
    <!-- app.manifest opts in to long path (>260 char) support on Windows 10 1607+ -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DupeHunter.Core\DupeHunter.Core.csproj" />
  </ItemGroup>

  <!-- Reuse the scanner CLI's internal console helpers (step spinner + VT enablement) without duplicating them. -->
  <ItemGroup>
    <Compile Include="..\StepProgress.cs" Link="Shared\StepProgress.cs" />
    <Compile Include="..\ConsoleVt.cs" Link="Shared\ConsoleVt.cs" />
  </ItemGroup>

</Project>
